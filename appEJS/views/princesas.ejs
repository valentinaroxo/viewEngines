<h1>Princesas Disney</h1>

<% if (preferencia && preferencia.length > 0) { %>
  <ul>
    <% preferencia.forEach(function(item) { %>
      <li>
        <strong><%= item.nome %></strong>
        <span> - <%= item.filme %></span>
      </li>
    <% }); %>
  </ul>
<% } else { %>
  <p>Nenhuma princesa encontrada.</p>
<% } %>